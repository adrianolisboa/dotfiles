# vim: ft=zsh sw=2 ts=2 expandtab

# Run a command with macforge secrets injected from 1Password at runtime.
# Nothing secret is written to disk: values live only in the child process's env
# and are masked in its output. Fill in ~/.config/macforge/secrets.env with
# op:// references (see osx-conf/secrets.env.example).
oprun() {
  local envfile="${MACFORGE_SECRETS_ENV:-$HOME/.config/macforge/secrets.env}"

  if ! command -v op >/dev/null 2>&1; then
    echo "oprun: 1Password CLI (op) not found. Install: brew install --cask 1password-cli" >&2
    return 1
  fi
  if [[ ! -f "$envfile" ]]; then
    echo "oprun: $envfile not found. Copy osx-conf/secrets.env.example there and fill in op:// references." >&2
    return 1
  fi

  op run --env-file="$envfile" -- "$@"
}
